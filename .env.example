# Copy to .env.local (never commit real values).
# Advisor requests are emailed only when all three are set; otherwise they are accepted and dropped (stub).
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Capstone VRI <advisor@your-domain>"
ADVISOR_EMAIL_FROM=
# Inbox that receives advisor requests
ADVISOR_EMAIL_TO=

# Public address of this deployment, e.g. https://example.org. Optional: when unset, the sitemap is empty and
# no absolute URLs are put in page metadata or robots.txt.
NEXT_PUBLIC_SITE_URL=
